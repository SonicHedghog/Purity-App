{
  "expo": {
    "name": "Purity App",
    "slug": "purity-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "purityapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.sonichedghog.purityapp",
      "infoPlist": {
        "NSContactsUsageDescription": "Purity App uses your contacts so you can quickly add an accountability partner."
      }
    },
    "android": {
      "package": "org.sonichedghog.purityapp",
      "adaptiveIcon": {
        "backgroundColor": "#4C6EF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Purity App uses your contacts so you can quickly add an accountability partner."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4C6EF5"
        }
      ],
      "expo-font",
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.org.sonichedghog.purityapp",
            "shield": {
              "title": "Hold on",
              "subtitle": "{appName} is limited. Purity App is helping you guard your time.",
              "primaryButtonLabel": "Open Purity App",
              "primaryButtonColor": "#4C6EF5"
            }
          },
          "android": {
            "overlayTitle": "App limited",
            "overlayText": "{appName} is limited. Purity App is helping you guard your time.",
            "overlayBackgroundColor": "#F6F8FC",
            "overlayTitleColor": "#1A1B25",
            "overlayTextColor": "#6B7280",
            "notificationTitle": "App limited",
            "notificationText": "{appName} is blocked until your next free time."
          }
        }
      ]
    ]
  }
}
